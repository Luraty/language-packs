{
  "name": "@luraty/pack-ar-x-quran",
  "version": "0.1.0",
  "description": "Qur'anic Arabic language pack for @luraty/engine — 10,850 lemmas ranked by Qur'anic frequency, 90,549 surface forms including mushaf spellings.",
  "keywords": [
    "luraty",
    "language-pack",
    "frequency-list",
    "lemmatization",
    "arabic",
    "quran",
    "quranic-arabic"
  ],
  "license": "MIT AND CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luraty/language-packs.git",
    "directory": "packs/ar-x-quran"
  },
  "homepage": "https://github.com/Luraty/language-packs/tree/main/packs/ar-x-quran#readme",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "frequency.txt",
    "lemmas.tsv",
    "pack.config.json",
    "ATTRIBUTION.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run check:publish",
    "build": "tsdown",
    "check:publish": "npm run build && publint --strict && node --input-type=module -e \"const m = await import('@luraty/pack-ar-x-quran'); if (m.vocabulary.length === 0) process.exit(1)\"",
    "vocab:write": "node scripts/vocab.mjs --write",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run check:publish"
  },
  "dependencies": {
    "@luraty/engine": "^0.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
